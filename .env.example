# CI 接入使用的共享HMAC密钥。
# 真实值不得提交，UTF-8编码后必须至少为32字节。
CFI_INGEST_HMAC_SECRET=

# CI失败详情读取接口使用的独立Bearer令牌。
# 真实值不得提交，UTF-8编码后必须至少为32字节。
CFI_FAILURE_READ_TOKEN=

# 触发可能产生费用的 AI 诊断使用独立 Bearer 令牌。
# 真实值不得提交，UTF-8 编码后必须至少为 32 字节。
CFI_AI_DIAGNOSIS_TRIGGER_TOKEN=

# CI 接入请求的原始HTTP Body上限，默认值为8MiB。
CFI_INGEST_MAX_BODY_BYTES=8388608

# CI 接入请求时间与服务器时间允许相差的最大秒数。
CFI_INGEST_TIMESTAMP_TOLERANCE_SECONDS=300

# nonce 保存时间，同时也是 Redis 新进程接收 CI 请求前的最短连续运行时间。
# 第一版安全下限为660秒，不能配置得更短。
CFI_INGEST_NONCE_TTL_SECONDS=660

# 本机运行的FastAPI通过Docker映射端口连接Redis。
CFI_REDIS_HOST=127.0.0.1
CFI_REDIS_PORT=6379

# Compose中创建的受限Redis ACL用户。
CFI_REDIS_USERNAME=cfi_ingest

# Redis真实密码不得提交，UTF-8编码后必须至少为32字节。
CFI_REDIS_PASSWORD=

# 第一版使用Redis逻辑数据库0。
CFI_REDIS_DATABASE=0

# Redis连接建立和命令响应的超时秒数。
CFI_REDIS_CONNECT_TIMEOUT_SECONDS=1.0
CFI_REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# 当前后端进程最多使用的Redis连接数量。
CFI_REDIS_MAX_CONNECTIONS=10

# 本机 FastAPI 通过 Docker 映射端口连接 PostgreSQL。
CFI_POSTGRES_HOST=127.0.0.1
CFI_POSTGRES_PORT=5432

# 正式项目数据库和受限应用账号。
CFI_POSTGRES_DATABASE=ci_failure_intelligence
CFI_POSTGRES_USERNAME=cfi_app

# PostgreSQL 真实密码不得提交，UTF-8 编码后必须至少为 32 字节。
CFI_POSTGRES_PASSWORD=

# 单个后端进程的 PostgreSQL 连接池规模。
CFI_POSTGRES_POOL_SIZE=5
CFI_POSTGRES_MAX_OVERFLOW=5

# 建立 PostgreSQL 连接允许等待的最长秒数。
CFI_POSTGRES_CONNECT_TIMEOUT_SECONDS=3

# DeepSeek AI诊断使用官方API；真实Key不得提交或打印。
CFI_DEEPSEEK_API_KEY=

# 第一版只允许DeepSeek官方地址和成本受控的Flash模型。
CFI_DEEPSEEK_API_BASE=https://api.deepseek.com
CFI_DEEPSEEK_MODEL=deepseek-flash

# 单次模型请求的超时、额外重试次数和最大输出token数。
CFI_DEEPSEEK_TIMEOUT_SECONDS=30
CFI_DEEPSEEK_MAX_RETRIES=1
CFI_DEEPSEEK_MAX_OUTPUT_TOKENS=4096
