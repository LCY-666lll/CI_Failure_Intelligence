# CI 接入使用的共享HMAC密钥。
# 真实值不得提交，UTF-8编码后必须至少为32字节。
CFI_INGEST_HMAC_SECRET=

# CI 接入请求的原始HTTP Body上限，默认值为8MiB。
CFI_INGEST_MAX_BODY_BYTES=8388608

# CI 接入请求时间与服务器时间允许相差的最大秒数。
CFI_INGEST_TIMESTAMP_TOLERANCE_SECONDS=300

# nonce 保存时间，同时也是 Redis 新进程接收 CI 请求前的最短连续运行时间。
# 第一版安全下限为660秒，不能配置得更短。
CFI_INGEST_NONCE_TTL_SECONDS=660

# 本机运行的FastAPI通过Docker映射端口连接Redis。
CFI_REDIS_HOST=127.0.0.1
CFI_REDIS_PORT=6379

# Compose中创建的受限Redis ACL用户。
CFI_REDIS_USERNAME=cfi_ingest

# Redis真实密码不得提交，UTF-8编码后必须至少为32字节。
CFI_REDIS_PASSWORD=

# 第一版使用Redis逻辑数据库0。
CFI_REDIS_DATABASE=0

# Redis连接建立和命令响应的超时秒数。
CFI_REDIS_CONNECT_TIMEOUT_SECONDS=1.0
CFI_REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# 当前后端进程最多使用的Redis连接数量。
CFI_REDIS_MAX_CONNECTIONS=10